{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "star-game-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "star-game-db",
      "database_id": "b2ad30d5-877b-4d65-a15f-0078f98e2ff9",
      "migrations_table": "d1_migrations",
      "migrations_dir": "migrations"
    }
  ]
}
